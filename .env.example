# Local-only service; model calls remain disabled by the expired example policy.
AEION_MODE=real
AEION_MAX_ACTIVE_MISSIONS=1
AEION_TEST_BACKEND=docker
AEION_AGENT_RUNTIME=opencode-cli
AEION_INFERENCE_BACKEND=docker
AEION_AGENT_TIMEOUT_SECONDS=180
# Hard cap on total recorded model exposure. The effective ceiling is the lower
# of this value and config/model-routing.json budget_usd; it cannot raise the
# authorized policy. The Docker stack passes this value into the cockpit.
# This is not a calendar-month reset; set the provider monthly limit separately.
AEION_BUDGET_USD=30
OPENCODE_BIN=vendor/opencode/node_modules/.bin/opencode
PAPERCLIP_BASE_URL=http://127.0.0.1:3101
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:3101
# Optional: a plain bearer token file readable by the cockpit user (0600).
# The Docker stack mounts runtime/secrets/paperclip_api_token instead.
PAPERCLIP_API_TOKEN_FILE=
# Native inference only. The Docker/gateway path uses
# runtime/secrets/opencode-provider.json, not these values. Never commit.
OPENCODE_API_KEY=
PAPERCLIP_API_TOKEN=
