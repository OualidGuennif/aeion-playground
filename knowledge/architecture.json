  "cards": [
    {
      "dot": "cyan",
      "title": "What runs where",
      "items": [
        "The cockpit, workboard, database, collector and gateway are Compose services.",
        "The executor agent is a host process; it is the only component with Docker access.",
        "Test and role containers are disposable and receive no socket, host home or provider key."
      ]
    },
    {
      "dot": "emerald",
      "title": "What decides",
      "items": [
        "The Gate reads the JUnit report and the policy, never the model's claim of success.",
        "Approval authority is separate from model output and is recorded in the ledger.",
        "The evidence packet is digest-sealed, not cryptographically signed."
      ]
    },
    {
      "dot": "rose",
      "title": "What is not wired",
      "items": [
        "GitHub delivery is pending: a filed issue is a specification, not an automatic run.",
        "Live provider inference has not been exercised in this repository.",
        "Budget and ledger authority remain in the cockpit; the agent cannot sign evidence."
      ]
    }
  ]
